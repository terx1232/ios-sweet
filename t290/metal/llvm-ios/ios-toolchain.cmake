# Cross toolchain: iPadOS 16 arm64 static libraries from Linux/WSL (clang 14 + iPhoneOS SDK).
set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(T290_SDK "$ENV{T290_IOS_SDK}" CACHE PATH "iPhoneOS SDK")
set(CMAKE_OSX_SYSROOT "${T290_SDK}")
set(CMAKE_OSX_ARCHITECTURES arm64)
set(CMAKE_C_COMPILER clang-14)
set(CMAKE_CXX_COMPILER clang++-14)
set(CMAKE_AR llvm-ar-14 CACHE FILEPATH "")
set(CMAKE_RANLIB llvm-ranlib-14 CACHE FILEPATH "")
set(CMAKE_LIBTOOL llvm-libtool-darwin-14 CACHE FILEPATH "")
set(CMAKE_C_COMPILER_TARGET arm64-apple-ios16.0)
set(CMAKE_CXX_COMPILER_TARGET arm64-apple-ios16.0)
set(CMAKE_C_FLAGS_INIT "-isysroot ${T290_SDK} -mcpu=cortex-a53")
set(CMAKE_CXX_FLAGS_INIT "-isysroot ${T290_SDK} -mcpu=cortex-a53 -stdlib=libc++")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH "${T290_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
