 	return kIOReturnSuccess;
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET && SWEET_T290 */
+
+/*
+ * Metal discovery (Metal.framework MTLRegisterDevices): services of class
+ * IOAcceleratorES name the driver bundle /System/Library/Extensions/
+ * <MetalPluginName>.bundle and its device class (MetalPluginClassName),
+ * created with -initWithAcceleratorPort:options:. T290Metal runs on Mesa
+ * through SweetGPU and needs nothing else from this node; user clients are
+ * refused and logged.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(SWEET_T290)
+#include <libkern/c++/OSString.h>
+
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+class T290Accelerator : public IOAcceleratorES {
+	OSDeclareDefaultStructors(T290Accelerator);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type,
+	    IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(T290Accelerator, IOAcceleratorES);
+
+bool
+T290Accelerator::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty("MetalPluginName", "T290Metal");
+	setProperty("MetalPluginClassName", "T290MetalDevice");
+	setProperty("IOGLESBundleName", "T290Metal");
+	setProperty("model", "T290 Adreno 504");
+	registerService();
+	IOLog("SWEET GPU: T290Accelerator (IOAcceleratorES) registered, Metal plugin T290Metal\n");
+	return true;
+}
+
+IOReturn
+T290Accelerator::newUserClient(task_t owningTask, void *securityID, UInt32 type, IOUserClient **handler)
+{
+	(void)owningTask;
+	(void)securityID;
+	(void)handler;
+	char name[64] = "?";
+	proc_name(proc_selfpid(), name, sizeof(name));
+	IOLog("SWEET GPU: T290Accelerator user client type %u from %s refused\n", (unsigned)type, name);
+	return kIOReturnUnsupported;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET && SWEET_T290 */
