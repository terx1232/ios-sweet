diff --git a/bsd/dev/sweet_t290_xfer.c b/bsd/dev/sweet_t290_xfer.c
--- a/bsd/dev/sweet_t290_xfer.c
+++ b/bsd/dev/sweet_t290_xfer.c
@@ -10,7 +10,7 @@
  * Layout from XFER_LBA (512-byte sectors, little-endian):
  *   +0        header: "T290XFR1", u32 nonce, u32 nops (<= 32), u32 state
  *             (0 pending, 1 done), u32 kernel results summary
- *   +1+i      op i: u32 op (1 put, 2 get), u32 mode, u64 size (put: bytes;
+ *   +1+i      op i: u32 op (1 put, 2 get, 3 mkdir), u32 mode, u64 size (put: bytes;
  *             get: capacity), u64 data_lba, i64 result (bytes or -errno),
  *             path at +64 (NUL-terminated, < 448 bytes)
  *   data      wherever data_lba points (beyond the op sectors)
@@ -22,6 +22,7 @@
 #include <sys/fcntl.h>
 #include <sys/kauth.h>
 #include <sys/uio.h>
+#include <sys/namei.h>
 #include <kern/thread.h>
 #include <kern/clock.h>
 #include <kern/kalloc.h>
@@ -111,6 +112,34 @@
 	return err ? -err : (int64_t)done;
 }
 
+/* one directory level (send parents first); an existing directory is fine */
+static int64_t
+xfer_mkdir(struct xfer_op *o, vfs_context_t ctx)
+{
+	struct nameidata nd;
+	NDINIT(&nd, CREATE, OP_MKDIR, LOCKPARENT | AUDITVNPATH1, UIO_SYSSPACE, CAST_USER_ADDR_T(o->path), ctx);
+	int err = namei(&nd);
+	if (err) {
+		return -err;
+	}
+	vnode_t dvp = nd.ni_dvp, vp = nd.ni_vp;
+	if (vp == NULLVP) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_type, VDIR);
+		VATTR_SET(&va, va_mode, (mode_t)(o->mode & 07777));
+		err = VNOP_MKDIR(dvp, &vp, &nd.ni_cnd, &va, ctx);
+	} else if (vnode_vtype(vp) != VDIR) {
+		err = ENOTDIR;
+	}
+	nameidone(&nd);
+	if (vp != NULLVP) {
+		vnode_put(vp);
+	}
+	vnode_put(dvp);
+	return err ? -err : 0;
+}
